# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Deny every .env variant, then re-allow the committed templates. The previous
# `.env` + `.env*.local` pair missed .env.production / .env.development, which
# is exactly the file someone creates in a hurry before a deploy.
.env*
!.env*.example

# vercel
.vercel

# trigger.dev local state
.trigger/

# repomix / context dumps — regenerated artifacts that duplicate the whole repo
repomix-output.*

# Claude Code — machine-local state. `.claude/launch.json` describes how to
# start the dev server on one particular machine, so it is noise in history.
# Anything genuinely shared (agents, project instructions) should be added back
# with a negation rather than by removing this rule.
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta
