# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Google OAuth (Better-Auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session signing secret (Better-Auth). REQUIRED in production — the app refuses
# to serve requests without it, because the library's fallback default would let
# anyone forge session tokens. Optional locally.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# OpenAI (Vercel AI SDK + Whisper)
OPENAI_API_KEY=sk-your-openai-api-key

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_your-trigger-secret-key

# Salt for hashing client IPs in the anonymous-extraction rate limiter.
# REQUIRED in production. Left unset, lib/anon-limit.ts falls back to a constant
# that is committed to this repository, so anyone could precompute the hash for
# a given IP. Any long random string works — it never needs to be rotated in
# sync with anything, but changing it resets everyone's free-extraction window.
# Generate with: openssl rand -base64 32
IP_HASH_SALT=

# Resend (lib/email.ts) — sends the confirmation link a creator must click
# to actually opt out or reverse an opt-out. REQUIRED for that flow to work
# at all in any environment; without it, submitting the /creators form still
# validates and rate-limits but throws when it tries to send.
# Get a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional: sender address for creator opt-out/reversal emails. Actually
# sending from it requires the domain to be verified in Resend — until
# that's done, leave this unset and it falls back to
# creators@tiktokrecipe.app, which will fail to send from an unverified
# domain. Point it at Resend's shared testing domain in the meantime, e.g.
# onboarding@resend.dev.
# CREATOR_EMAIL_FROM=

# Optional: absolute path to the yt-dlp binary, for audio extraction.
# Only needed if yt-dlp isn't on PATH or lives somewhere unusual. Left unset,
# the app resolves plain "yt-dlp" via PATH, which covers a Homebrew install
# locally. The deployed Trigger.dev worker sets this automatically via the
# build extension in trigger.config.ts.
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
